th=1.5;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.02;entryDx=0;entryDy=0;" edge="1" parent="arch-r1" source="arch-50" target="arch-18"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1650" y="312" /><mxPoint x="1650" y="600" /></Array></mxGeometry></mxCell><mxCell id="arch-62" value="osnadmin (mTLS)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.278;entryDx=0;entryDy=0;" edge="1" parent="arch-r1" source="arch-52" target="arch-34"><mxGeometry relative="1" as="geometry" x="0.3"><Array as="points"><mxPoint x="590" y="282" /><mxPoint x="590" y="870" /></Array></mxGeometry></mxCell><mxCell id="arch-63" value="enroll" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="arch-r1" source="arch-3" target="arch-4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="arch-64" value="enroll" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="arch-r1" source="arch-15" target="arch-16"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="arch-65" value="enroll" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="arch-r1" source="arch-32" target="arch-33"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="arch-66" value="① Proposal&lt;br&gt;(подпись X.509, TLS)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.28;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="arch-r1" source="arch-5" target="arch-7"><mxGeometry relative="1" as="geometry" x="-0.4" /></mxCell><mxCell id="arch-67" value="⑥ статус commit (TxID)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;exitX=0.75;exitY=0;exitDx=0;exitDy=0;entryX=0.727;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="arch-r1" source="arch-7" target="arch-5"><mxGeometry relative="1" as="geometry" x="-0.4" /></mxCell><mxCell id="arch-68" value="Accept / Settle&lt;br&gt;(processor2)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="arch-r1" source="arch-17" target="arch-19"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="arch-69" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="arch-r1" source="arch-7" target="arch-9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="arch-70" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="arch-r1" source="arch-19" target="arch-21"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="arch-71" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="arch-r1" source="arch-9" target="arch-10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="arch-72" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="arch-r1" source="arch-21" target="arch-22"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="arch-73" value="shim" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.82;entryDx=0;entryDy=0;" edge="1" parent="arch-r1" source="arch-9" target="arch-8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="arch-74" value="shim" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.82;entryDx=0;entryDy=0;" edge="1" parent="arch-r1" source="arch-21" target="arch-20"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="arch-75" value="② Endorsement: ProcessProposal → peer0.org2 (политика AND)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.357;entryDx=0;entryDy=0;" edge="1" parent="arch-r1" source="arch-7" target="arch-21"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1150" y="660" /><mxPoint x="1150" y="735" /></Array></mxGeometry></mxCell><mxCell id="arch-76" value="③ Submit" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.9;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="arch-r1" source="arch-7" target="arch-34"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="575" y="684" /><mxPoint x="575" y="890" /></Array></mxGeometry></mxCell><mxCell id="arch-77" value="④ Deliver block" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=0;exitY=0.8;exitDx=0;exitDy=0;entryX=1;entryY=0.7857;entryDx=0;entryDy=0;" edge="1" parent="arch-r1" source="arch-34" target="arch-9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="550" y="917" /><mxPoint x="550" y="765" /></Array></mxGeometry></mxCell><mxCell id="arch-78" value="④ Deliver block" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.7857;entryDx=0;entryDy=0;" edge="1" parent="arch-r1" source="arch-34" target="arch-21"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1150" y="917" /><mxPoint x="1150" y="765" /></Array></mxGeometry></mxCell><mxCell id="arch-79" value="&lt;b&gt;Поток транзакции: Execute → Order → Validate → Commit&lt;/b&gt;&lt;br&gt;① Client подписывает proposal и отправляет его в Fabric Gateway своей организации (gRPC + TLS).&lt;br&gt;② Gateway выполняет симуляцию на peer0.org1 и запрашивает endorsement у peer0.org2 (политика AND): формируются Read/Write Set, ledger не изменяется.&lt;br&gt;③ Клиент подписывает подготовленную транзакцию, Gateway отправляет её в Ordering Service.&lt;br&gt;④ Ordering Service упорядочивает транзакции, формирует блок и доставляет его peers.&lt;br&gt;⑤ Каждый peer проверяет Endorsement Policy (VSCC) и версии ключей Read Set (MVCC); write-set валидных tx применяется к World State, блок целиком (с кодами валидации) дописывается в Blockchain.&lt;br&gt;⑥ Gateway возвращает клиенту статус фиксации: TxID + VALID / MVCC_READ_CONFLICT / ENDORSEMENT_POLICY_FAILURE." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=6;fillColor=#f5f5f5;strokeColor=#999999;rounded=1;arcSize=3;" vertex="1" parent="arch-r1"><mxGeometry x="40" y="1120" width="1000" height="240" as="geometry" /></mxCell><mxCell id="arch-80" value="&lt;b&gt;Доверительные границы (для STRIDE, Задание 2)&lt;/b&gt;&lt;br&gt;&lt;font color='#b85450'&gt;Пунктирная красная рамка = доверительная граница&lt;/font&gt;&lt;br&gt;TB1 — граница организации: свои администраторы, CA, MSP, peers&lt;br&gt;TB2 — Client ↔ Peer / Gateway: mTLS + подпись X.509 клиента&lt;br&gt;TB3 — Организации ↔ Ordering Service&lt;br&gt;TB4 — Peer ↔ контейнер chaincode (shim gRPC)&lt;br&gt;TB5 — Fabric CA ↔ участники (выпуск идентичностей, атрибуты role)&lt;br&gt;TB6 — внешние клиенты банков ↔ Client Application (вне Fabric, без X.509)&lt;br&gt;&lt;b&gt;Цвета:&lt;/b&gt; синий — Org1, зелёный — Org2, оранжевый — Ordering, фиолетовый — Channel, жёлтый — Ledger, розовый — конфиденциальные данные / уязвимость" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=6;fillColor=#f5f5f5;strokeColor=#999999;rounded=1;arcSize=3;" vertex="1" parent="arch-r1"><mxGeometry x="1060" y="1120" width="600" height="240" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="flow" name="2. Поток транзакции и PDC"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1120" math="0" shadow="0"><root><mxCell id="flow-r0" /><mxCell id="flow-r1" parent="flow-r0" /><mxCell id="flow-1" value="&lt;b&gt;Жизненный цикл транзакции SettlePaymentOrder и поток конфиденциальных данных (PDC)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=6;fontSize=16;verticalAlign=middle;" vertex="1" parent="flow-r1"><mxGeometry x="40" y="20" width="1620" height="44" as="geometry" /></mxCell><mxCell id="flow-2" value="&lt;b&gt;EXECUTE&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontSize=11;rounded=0;fillColor=#dae8fc;strokeColor=none;opacity=60;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="flow-r1"><mxGeometry x="30" y="160" width="1220" height="400" as="geometry" /></mxCell><mxCell id="flow-3" value="&lt;b&gt;ORDER&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontSize=11;rounded=0;fillColor=#ffe6cc;strokeColor=none;opacity=60;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="flow-r1"><mxGeometry x="30" y="560" width="1220" height="200" as="geometry" /></mxCell><mxCell id="flow-4" value="&lt;b&gt;VALIDATE&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontSize=11;rounded=0;fillColor=#e1d5e7;strokeColor=none;opacity=60;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="flow-r1"><mxGeometry x="30" y="760" width="1220" height="170" as="geometry" /></mxCell><mxCell id="flow-5" value="&lt;b&gt;COMMIT&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontSize=11;rounded=0;fillColor=#d5e8d4;strokeColor=none;opacity=60;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="flow-r1"><mxGeometry x="30" y="930" width="1220" height="150" as="geometry" /></mxCell><mxCell id="flow-6" value="&lt;b&gt;Client App (Org1)&lt;br&gt;initiator1@Org1MSP&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="flow-r1"><mxGeometry x="40" y="80" width="220" height="60" as="geometry" /></mxCell><mxCell id="flow-7" value="" style="html=1;endArrow=none;dashed=1;strokeColor=#888888;strokeWidth=1;" edge="1" parent="flow-r1"><mxGeometry relative="1" as="geometry"><mxPoint x="150" y="140" as="sourcePoint" /><mxPoint x="150" y="1080" as="targetPoint" /></mxGeometry></mxCell><mxCell id="flow-8" value="&lt;b&gt;peer0.org1&lt;br&gt;Gateway · Endorser · Committer&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="flow-r1"><mxGeometry x="320" y="80" width="220" height="60" as="geometry" /></mxCell><mxCell id="flow-9" value="" style="html=1;endArrow=none;dashed=1;strokeColor=#888888;strokeWidth=1;" edge="1" parent="flow-r1"><mxGeometry relative="1" as="geometry"><mxPoint x="430" y="140" as="sourcePoint" /><mxPoint x="430" y="1080" as="targetPoint" /></mxGeometry></mxCell><mxCell id="flow-10" value="&lt;b&gt;peer0.org2&lt;br&gt;Endorser · Committer&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="flow-r1"><mxGeometry x="600" y="80" width="220" height="60" as="geometry" /></mxCell><mxCell id="flow-11" value="" style="html=1;endArrow=none;dashed=1;strokeColor=#888888;strokeWidth=1;" edge="1" parent="flow-r1"><mxGeometry relative="1" as="geometry"><mxPoint x="710" y="140" as="sourcePoint" /><mxPoint x="710" y="1080" as="targetPoint" /></mxGeometry></mxCell><mxCell id="flow-12" value="&lt;b&gt;Ordering Service&lt;br&gt;orderer.example.com&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="flow-r1"><mxGeometry x="880" y="80" width="220" height="60" as="geometry" /></mxCell><mxCell id="flow-13" value="" style="html=1;endArrow=none;dashed=1;strokeColor=#888888;strokeWidth=1;" edge="1" parent="flow-r1"><mxGeometry relative="1" as="geometry"><mxPoint x="990" y="140" as="sourcePoint" /><mxPoint x="990" y="1080" as="targetPoint" /></mxGeometry></mxCell><mxCell id="flow-14" value="1. SignedProposal: SettlePaymentOrder(PO-0001)" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="flow-r1"><mxGeometry relative="1" as="geometry"><mxPoint x="150" y="190" as="sourcePoint" /><mxPoint x="430" y="190" as="targetPoint" /></mxGeometry></mxCell><mxCell id="flow-15" value="2. Симуляция chaincode → Read/Write Set&lt;br&gt;(ledger не изменяется)" style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#999999;fontSize=10;" vertex="1" parent="flow-r1"><mxGeometry x="440" y="220" width="250" height="42" as="geometry" /></mxCell><mxCell id="flow-16" value="3. ProcessProposal (EP: AND Org1 &amp; Org2)" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="flow-r1"><mxGeometry relative="1" as="geometry"><mxPoint x="430" y="290" as="sourcePoint" /><mxPoint x="710" y="290" as="targetPoint" /></mxGeometry></mxCell><mxCell id="flow-17" value="4. Симуляция + подпись endorsement Org2" style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#999999;fontSize=10;" vertex="1" parent="flow-r1"><mxGeometry x="720" y="315" width="250" height="34" as="geometry" /></mxCell><mxCell id="flow-18" value="5. ProposalResponse (RW-set + подпись)" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="flow-r1"><mxGeometry relative="1" as="geometry"><mxPoint x="710" y="380" as="sourcePoint" /><mxPoint x="430" y="380" as="targetPoint" /></mxGeometry></mxCell><mxCell id="flow-19" value="6. Сверка RW-set всех endorsers (детерминизм!)&lt;br&gt;endorsements собраны" style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#999999;fontSize=10;" vertex="1" parent="flow-r1"><mxGeometry x="440" y="405" width="250" height="42" as="geometry" /></mxCell><mxCell id="flow-20" value="7. Подготовленная транзакция → подпись клиента" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="flow-r1"><mxGeometry relative="1" as="geometry"><mxPoint x="430" y="500" as="sourcePoint" /><mxPoint x="150" y="500" as="targetPoint" /></mxGeometry></mxCell><mxCell id="flow-21" value="8. Submit (подписанный envelope)" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="flow-r1"><mxGeometry relative="1" as="geometry"><mxPoint x="150" y="590" as="sourcePoint" /><mxPoint x="430" y="590" as="targetPoint" /></mxGeometry></mxCell><mxCell id="flow-22" value="9. Broadcast в Ordering Service" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="flow-r1"><mxGeometry relative="1" as="geometry"><mxPoint x="430" y="640" as="sourcePoint" /><mxPoint x="990" y="640" as="targetPoint" /></mxGeometry></mxCell><mxCell id="flow-23" value="10. Консенсус (Raft / SmartBFT),&lt;br&gt;формирование блока N" style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#999999;fontSize=10;" vertex="1" parent="flow-r1"><mxGeometry x="1000" y="670" width="230" height="42" as="geometry" /></mxCell><mxCell id="flow-24" value="11. Deliver block N" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="flow-r1"><mxGeometry relative="1" as="geometry"><mxPoint x="990" y="790" as="sourcePoint" /><mxPoint x="430" y="790" as="targetPoint" /></mxGeometry></mxCell><mxCell id="flow-25" value="11. Deliver block N" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="flow-r1"><mxGeometry relative="1" as="geometry"><mxPoint x="990" y="820" as="sourcePoint" /><mxPoint x="710" y="820" as="targetPoint" /></mxGeometry></mxCell><mxCell id="flow-26" value="12. VSCC: проверка Endorsement Policy · MVCC: версии ключей Read Set == текущим?&lt;br&gt;→ VALID | MVCC_READ_CONFLICT | ENDORSEMENT_POLICY_FAILURE" style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#999999;fontSize=10;" vertex="1" parent="flow-r1"><mxGeometry x="440" y="850" width="540" height="50" as="geometry" /></mxCell><mxCell id="flow-27" value="13. Блок N → Blockchain (все tx с кодами валидации); write-set только валидных tx → World State;&lt;br&gt;private data → side DB членов коллекции" style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#999999;fontSize=10;" vertex="1" parent="flow-r1"><mxGeometry x="440" y="950" width="540" height="50" as="geometry" /></mxCell><mxCell id="flow-28" value="14. Commit status: TxID + VALID" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="flow-r1"><mxGeometry relative="1" as="geometry"><mxPoint x="430" y="1040" as="sourcePoint" /><mxPoint x="150" y="1040" as="targetPoint" /></mxGeometry></mxCell><mxCell id="flow-29" value="&lt;b&gt;Private Data Collection (chaincode paymentsecure)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=6;fontSize=13;verticalAlign=middle;" vertex="1" parent="flow-r1"><mxGeometry x="1260" y="80" width="410" height="40" as="geometry" /></mxCell><mxCell id="flow-30" value="&lt;b&gt;Client Org1&lt;/b&gt; (initiator1)&lt;br&gt;transient map: {&quot;settlement&quot;: JSON(IBAN, BIC, БИН, имя, salt)}&lt;br&gt;args = только ID → реквизиты не попадают в блок" style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="flow-r1"><mxGeometry x="1270" y="130" width="390" height="95" as="geometry" /></mxCell><mxCell id="flow-31" value="&lt;b&gt;peer0.org1 → paymentsecure.SetSettlementDetails&lt;/b&gt;&lt;br&gt;GetTransient() → валидация → MSP / role&lt;br&gt;PutPrivateData(collectionSettlementDetails, id, value)" style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="flow-r1"><mxGeometry x="1270" y="265" width="390" height="85" as="geometry" /></mxCell><mxCell id="flow-32" value="&lt;b&gt;peer0.org1&lt;/b&gt;&lt;br&gt;Private Data Store:&lt;br&gt;реквизиты (plaintext)" style="whiteSpace=wrap;html=1;fontSize=11;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#f8cecc;strokeColor=#666666;" vertex="1" parent="flow-r1"><mxGeometry x="1270" y="395" width="185" height="110" as="geometry" /></mxCell><mxCell id="flow-33" value="&lt;b&gt;Блок (все peers, orderer)&lt;/b&gt;&lt;br&gt;только hash(key), hash(value)&lt;br&gt;в collection_hashed_rwset" style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="flow-r1"><mxGeometry x="1475" y="395" width="185" height="110" as="geometry" /></mxCell><mxCell id="flow-34" value="&lt;b&gt;peer0.org2&lt;/b&gt; (не член коллекции)&lt;br&gt;хранит только хэш → VerifySettlementDetails через GetPrivateDataHash()&lt;br&gt;ReadSettlementDetails / GetPrivateData → отказ" style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#666666;" vertex="1" parent="flow-r1"><mxGeometry x="1270" y="545" width="390" height="95" as="geometry" /></mxCell><mxCell id="flow-35" value="endorse только peer0.org1&lt;br&gt;(collection-level EP)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="flow-r1" source="flow-30" target="flow-31"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="flow-36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="flow-r1" source="flow-31" target="flow-32"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="flow-37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="flow-r1" source="flow-31" target="flow-33"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="flow-38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.8;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="flow-r1" source="flow-33" target="flow-34"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="flow-39" value="[{&lt;br&gt;&amp;nbsp;&quot;name&quot;: &quot;collectionSettlementDetails&quot;,&lt;br&gt;&amp;nbsp;&quot;policy&quot;: &quot;OR('Org1MSP.member')&quot;,&lt;br&gt;&amp;nbsp;&quot;requiredPeerCount&quot;: 0,&lt;br&gt;&amp;nbsp;&quot;maxPeerCount&quot;: 1,&lt;br&gt;&amp;nbsp;&quot;blockToLive&quot;: 0,&lt;br&gt;&amp;nbsp;&quot;memberOnlyRead&quot;: true,&lt;br&gt;&amp;nbsp;&quot;memberOnlyWrite&quot;: true,&lt;br&gt;&amp;nbsp;&quot;endorsementPolicy&quot;: {&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;signaturePolicy&quot;: &quot;OR('Org1MSP.peer')&quot;&lt;br&gt;&amp;nbsp;}&lt;br&gt;}]" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=6;fontFamily=Courier New;fontSize=11;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="flow-r1"><mxGeometry x="1270" y="680" width="390" height="230" as="geometry" /></mxCell><mxCell id="flow-40" value="&lt;b&gt;Важно (OWASP SC01 / SC04):&lt;/b&gt; случайная salt в transient защищает хэш низкоэнтропийных реквизитов от перебора; транзакция с transient endorse-ится только peers членов коллекции — иначе Org2 увидит реквизиты в proposal на этапе Execute." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=6;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;arcSize=4;" vertex="1" parent="flow-r1"><mxGeometry x="1270" y="930" width="390" height="140" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="bft" name="3. Стенд SmartBFT"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1000" math="0" shadow="0"><root><mxCell id="bft-r0" /><mxCell id="bft-r1" parent="bft-r0" /><mxCell id="bft-1" value="&lt;b&gt;Задание 3.7 — отдельный стенд Fabric 3.1.5 с SmartBFT Ordering Service&lt;/b&gt; (канал bftchannel)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=6;fontSize=16;verticalAlign=middle;" vertex="1" parent="bft-r1"><mxGeometry x="40" y="20" width="1620" height="44" as="geometry" /></mxCell><mxCell id="bft-2" value="Ordering Service: SmartBFT · OrdererMSP · Channel capability V3_0" style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=2;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=12;" vertex="1" parent="bft-r1"><mxGeometry x="40" y="80" width="1000" height="570" as="geometry" /></mxCell><mxCell id="bft-3" value="&lt;b&gt;orderer.example.com&lt;/b&gt; :7050 · admin :7053&lt;br&gt;consenter 1 (id 1)&lt;br&gt;лидер view 0 (по логам ChangeRole)" style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="bft-r1"><mxGeometry x="100" y="140" width="220" height="90" as="geometry" /></mxCell><mxCell id="bft-4" value="&lt;b&gt;orderer2.example.com&lt;/b&gt; :7052 · admin :7055&lt;br&gt;consenter 2 (id 2)" style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="bft-r1"><mxGeometry x="400" y="140" width="220" height="90" as="geometry" /></mxCell><mxCell id="bft-5" value="&lt;b&gt;orderer3.example.com&lt;/b&gt; :7056 · admin :7057&lt;br&gt;consenter 3 (id 3)" style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="bft-r1"><mxGeometry x="100" y="330" width="220" height="90" as="geometry" /></mxCell><mxCell id="bft-6" value="&lt;b&gt;orderer4.example.com&lt;/b&gt; :7058 · admin :7059&lt;br&gt;consenter 4 (id 4)&lt;br&gt;&lt;b&gt;docker stop&lt;/b&gt; → crash fault ✕" style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;" vertex="1" parent="bft-r1"><mxGeometry x="400" y="330" width="220" height="90" as="geometry" /></mxCell><mxCell id="bft-7" value="" style="html=1;endArrow=none;dashed=1;strokeColor=#d79b00;strokeWidth=1.5;" edge="1" parent="bft-r1" source="bft-3" target="bft-4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="bft-8" value="" style="html=1;endArrow=none;dashed=1;strokeColor=#d79b00;strokeWidth=1.5;" edge="1" parent="bft-r1" source="bft-5" target="bft-6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="bft-9" value="" style="html=1;endArrow=none;dashed=1;strokeColor=#d79b00;strokeWidth=1.5;" edge="1" parent="bft-r1" source="bft-3" target="bft-5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="bft-10" value="" style="html=1;endArrow=none;dashed=1;strokeColor=#d79b00;strokeWidth=1.5;" edge="1" parent="bft-r1" source="bft-4" target="bft-6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="bft-11" value="" style="html=1;endArrow=none;dashed=1;strokeColor=#d79b00;strokeWidth=1.5;" edge="1" parent="bft-r1" source="bft-3" target="bft-6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="bft-12" value="" style="html=1;endArrow=none;dashed=1;strokeColor=#d79b00;strokeWidth=1.5;" edge="1" parent="bft-r1" source="bft-4" target="bft-5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="bft-13" value="консенсусные сообщения BFT (mesh, TLS)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=6;fontSize=9;align=center;verticalAlign=middle;fillColor=#fff8ef;strokeColor=#d79b00;rounded=1;" vertex="1" parent="bft-r1"><mxGeometry x="330" y="250" width="60" height="60" as="geometry" /></mxCell><mxCell id="bft-14" value="&lt;b&gt;Эксперимент&lt;/b&gt;&lt;br&gt;1. Базовая транзакция → VALID, высота H на всех узлах.&lt;br&gt;2. docker stop orderer4 (не лидер) → живы 3 из 4 = кворум.&lt;br&gt;3. Контрольная транзакция → VALID, высота H+1.&lt;br&gt;4. docker start orderer4 → catch-up до H+1.&lt;br&gt;5. (доп.) стоп лидера → view change; стоп 2 узлов (&amp;gt; f) → нет кворума." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=6;fillColor=#ffffff;strokeColor=#999999;rounded=1;arcSize=4;" vertex="1" parent="bft-r1"><mxGeometry x="60" y="450" width="480" height="180" as="geometry" /></mxCell><mxCell id="bft-15" value="&lt;b&gt;n = 3f + 1 = 4 → f = 1&lt;/b&gt;&lt;br&gt;Кворум q = ⌈(n + f + 1) / 2⌉ = 3&lt;br&gt;&lt;br&gt;Crash ≠ Byzantine: остановленный узел просто молчит. Он не рассылает противоречивые сообщения (equivocation), не подписывает конфликтующие блоки и не цензурирует транзакции — поэтому тест доказывает устойчивость к crash fault, но не к произвольному византийскому поведению." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=6;fillColor=#fff2cc;strokeColor=#d6b656;rounded=1;arcSize=4;" vertex="1" parent="bft-r1"><mxGeometry x="560" y="450" width="460" height="180" as="geometry" /></mxCell><mxCell id="bft-16" value="&lt;b&gt;peer0.org1.example.com&lt;/b&gt;&lt;br&gt;Org1MSP · Gateway" style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="bft-r1"><mxGeometry x="1100" y="145" width="260" height="80" as="geometry" /></mxCell><mxCell id="bft-17" value="&lt;b&gt;peer0.org2.example.com&lt;/b&gt;&lt;br&gt;Org2MSP" style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="bft-r1"><mxGeometry x="1100" y="335" width="260" height="80" as="geometry" /></mxCell><mxCell id="bft-18" value="&lt;b&gt;Client&lt;/b&gt;&lt;br&gt;контрольная транзакция&lt;br&gt;(TxID фиксируется)" style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="bft-r1"><mxGeometry x="1410" y="240" width="240" height="80" as="geometry" /></mxCell><mxCell id="bft-19" value="Broadcast / Deliver" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="bft-r1" source="bft-16" target="bft-4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="bft-20" value="недоступен → failover&lt;br&gt;на живые orderer" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#b85450;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="bft-r1" source="bft-17" target="bft-6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="bft-21" value="Proposal / Submit" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="bft-r1" source="bft-18" target="bft-16"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="bft-22" value="Стенд поднимается отдельно от основной сети:&lt;br&gt;&lt;code&gt;./network.sh up createChannel -bft -c bftchannel&lt;/code&gt;&lt;br&gt;Имена/порты orderer сверить с compose-bft-test-net.yaml.&lt;br&gt;* лидера определить по логам orderer." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=6;fillColor=#f5f5f5;strokeColor=#999999;rounded=1;arcSize=4;" vertex="1" parent="bft-r1"><mxGeometry x="1100" y="460" width="560" height="120" as="geometry" /></mxCell><mxCell id="bft-23" value="&lt;table border='1' cellpadding='4' style='border-collapse:collapse;width:100%;font-size:11px'&gt;&lt;tr&gt;&lt;th&gt;Параметр&lt;/th&gt;&lt;th&gt;Raft (CFT)&lt;/th&gt;&lt;th&gt;SmartBFT (BFT)&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Модель отказов&lt;/td&gt;&lt;td&gt;crash: остановка, потеря связи&lt;/td&gt;&lt;td&gt;произвольное (византийское) поведение до f узлов&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Число узлов&lt;/td&gt;&lt;td&gt;n = 2f + 1&lt;/td&gt;&lt;td&gt;n = 3f + 1&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Кворум&lt;/td&gt;&lt;td&gt;большинство ⌊n/2⌋ + 1&lt;/td&gt;&lt;td&gt;⌈(n + f + 1) / 2⌉&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Минимум для f = 1&lt;/td&gt;&lt;td&gt;3 узла&lt;/td&gt;&lt;td&gt;4 узла&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Лидер&lt;/td&gt;&lt;td&gt;доверенный; злонамеренный лидер может цензурировать или менять порядок&lt;/td&gt;&lt;td&gt;предложения лидера проверяются, при подозрении — view change&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Модель доверия&lt;/td&gt;&lt;td&gt;orderer-ы одного или взаимно доверяющих операторов&lt;/td&gt;&lt;td&gt;orderer-ы разных организаций без взаимного доверия&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Fabric&lt;/td&gt;&lt;td&gt;2.x и 3.x&lt;/td&gt;&lt;td&gt;3.x (channel capability V3_0)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=6;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="bft-r1"><mxGeometry x="40" y="680" width="1620" height="290" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>